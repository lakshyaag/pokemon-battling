{
  "name": "pokemon-battle-server",
  "version": "1.0.0",
  "description": "Pokemon battle server using pkmn packages",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@pkmn/sim": "^0.9.38",
    "@pkmn/randoms": "^0.9.38",
    "@pkmn/protocol": "^0.6.20",
    "@pkmn/data": "^0.9.11",
    "@pkmn/sets": "^5.2.0",
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "uuid": "^9.0.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/ws": "^8.5.8",
    "@types/uuid": "^9.0.6",
    "@types/cors": "^2.8.15",
    "@types/node": "^20.8.10",
    "typescript": "^5.2.2",
    "@types/bun": "latest"
  }
}